#!/bin/sh /etc/rc.common

# OpenWrt procd init script for luffy.
#
# Install:
#   cp init.d/luffy /etc/init.d/luffy
#   cp luffy-linux-mips-softfloat /usr/bin/luffy
#   /etc/init.d/luffy enable
#   /etc/init.d/luffy start
#
# The script keeps the original piratebox service name so existing rc.d
# ordering keeps working.

START=95
STOP=10

USE_PROCD=1

PROG=/usr/bin/luffy
CONF=/opt/piratebox/conf/piratebox.conf

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" --config "$CONF" start
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

stop_service() {
	"$PROG" --config "$CONF" stop
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "piratebox"
}
